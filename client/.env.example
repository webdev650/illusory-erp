# Optional: URL of deployed backend API (e.g. https://illusory-erp-api.onrender.com)
# When unset in local development, Vite proxies /api to http://localhost:5000
VITE_API_URL=

# Set to true during development to show quick login buttons (Super Admin, HR, Employee)
# Set to false in production
VITE_SHOW_QUICK_LOGIN=true

